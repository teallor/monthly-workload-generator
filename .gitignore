~$*

# Generated previews, audit snapshots and final workbooks contain business data.
# Keep them locally; use a sanitized examples/ folder for repository samples.
output/
输出/
output_final_check/
output_no_ocr/
output_ocr/
output_ocr_probe/
tmp/
materials/
workspace/
app_settings.json
# Local release history and binaries stay out of Git. Only sanitized release
# manifests/instructions under release/latest may be tracked; EXE/ZIP files are
# distributed as GitHub Release assets instead of normal repository blobs.
release/*
!release/README.md
!release/latest/
release/latest/*
!release/latest/RELEASE_CHECKLIST.md
!release/latest/使用说明.md
!release/latest/SHA256.txt
!release/backup/
release/backup/*
temp_release_test/

# Real Office/image inputs and manually verified sidecars are business data.
# Sanitized repository fixtures may be placed under examples/.
*.doc
*.docx
*.pdf
*.xls
*.xlsx
*.xlsm
*.csv
*.jpg
*.jpeg
*.png
*.jpg.records.json
*.jpeg.records.json
*.png.records.json
!examples/**

# Private local archives and real materials must never be published.
local_private/
archive_private/
真实材料/
原始材料/
测试真实数据/
private/
secrets/
